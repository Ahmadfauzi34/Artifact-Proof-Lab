{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proof-gated-agent-gym/host-wire-protocol.schema.json",
  "title": "G2.1 Reference Private-Host JSONL Envelope",
  "description": "Reference subprocess framing only. Other transports may implement the same logical HostGateway contract.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "op", "payload"],
      "properties": {
        "protocol": {"const": "proof-gym-host-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "op": {
          "enum": ["HELLO", "START", "STEP", "SEMANTIC_VERDICT", "CLOSE", "PING", "SHUTDOWN"]
        },
        "payload": {"type": "object"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "ok", "result"],
      "properties": {
        "protocol": {"const": "proof-gym-host-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "ok": {"const": true},
        "result": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "ok", "error"],
      "properties": {
        "protocol": {"const": "proof-gym-host-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"}
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ]
}
