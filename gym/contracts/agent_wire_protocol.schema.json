{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/proof-gated-agent-gym/agent-wire-protocol.schema.json",
  "title": "G2.3 Reference Agent Endpoint JSONL Envelope",
  "description": "Reference process-isolation framing. Native agents may use another transport if the same sanitized logical boundary is preserved.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "op", "payload"],
      "properties": {
        "protocol": {"const": "proof-gym-agent-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "op": {
          "enum": [
            "HELLO",
            "START",
            "DECIDE",
            "GENERATE",
            "CLOSE",
            "PING",
            "SHUTDOWN"
          ]
        },
        "payload": {"type": "object"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "ok", "result"],
      "properties": {
        "protocol": {"const": "proof-gym-agent-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "ok": {"const": true},
        "result": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "request_id", "ok", "error"],
      "properties": {
        "protocol": {"const": "proof-gym-agent-jsonl-v1"},
        "request_id": {"type": "string", "minLength": 1},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"}
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ]
}
